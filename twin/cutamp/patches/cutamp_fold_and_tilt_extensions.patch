diff --git a/cutamp/tilt_registry.py b/cutamp/tilt_registry.py
new file mode 100644
index 0000000..700038f
--- /dev/null
+++ b/cutamp/tilt_registry.py
@@ -0,0 +1,24 @@
+# Tilt-aware placement registry (real2sim2real extension).
+#
+# Maps a placement SURFACE name -> a tilted support plane, so cuTAMP can plan placements
+# that rest FLUSH on a non-horizontal (e.g. reconstructed, tilted) container floor.
+#
+# For a registered surface:
+#   * the rollout composes T4 (box-local -> world) into the object's placement pose, so the
+#     object is placed at the box orientation and the grasp/IK reach is evaluated on the
+#     TILTED pose (reachability of the tilt is tested, not assumed);
+#   * the StablePlacement support/in-xy constraints transform object spheres into the
+#     box-local frame (R, origin) and test against the box-local footprint + floor.
+#
+# Each entry: surface_name -> {
+#   "T4":     torch (4,4) box-local -> world  (rotation R + origin t),
+#   "R":      torch (3,3) box axes as columns,
+#   "origin": torch (3,)  box-local origin (floor centre) in world,
+#   "bounds": (xmin, xmax, ymin, ymax) box-local footprint half-extents,
+#   "floor_z":float box-local floor height (object bottom target),
+# }
+SURFACE_TILT = {}
+
+
+def clear():
+    SURFACE_TILT.clear()
